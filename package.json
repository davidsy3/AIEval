{
  "name": "ai-evaluator",
  "displayName": "AI Evaluator",
  "publisher": "aieval",
  "description": "Analyze newly accepted AI-generated Python code for security vulnerabilities.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiEvaluator.open",
        "title": "AI Evaluator: Open"
      },
      {
        "command": "aiEvaluator.analyzeForVulnerabilities",
        "title": "NerdGoose",
        "icon": "media/logoSide.png"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiEvaluator",
          "title": "NerdGoose",
          "icon": "media/logoSide.png"
        }
      ]
    },
    "views": {
      "aiEvaluator": [
        {
          "id": "aiEvaluator.analyze",
          "name": "",
          "icon": "media/logoSide.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiEvaluator.analyze",
        "contents": "Analyze the active Python file for security vulnerabilities.\n[Run AI Analysis](command:aiEvaluator.analyzeForVulnerabilities)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aiEvaluator.analyzeForVulnerabilities",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
